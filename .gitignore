# =========================================================
# Terraform
# =========================================================

# Terraform downloaded providers/modules
**/.terraform/*

# Terraform state
*.tfstate
*.tfstate.*

# Saved Terraform plans
*.tfplan

# Backend environment configuration
backend-*.hcl

# Crash logs
crash.log
crash.*.log

# Terraform override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json
backend-*.hcl

# Terraform CLI configuration
.terraformrc
terraform.rc

# IMPORTANT:
# .terraform.lock.hcl is intentionally NOT ignored.
# Commit it to Git.

